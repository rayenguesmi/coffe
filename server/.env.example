PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quickcafe
DB_USER=root
DB_PASS=secret

# JWT
JWT_SECRET=changeme_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Email (Gmail App Password)
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password

# URLs
CLIENT_ORIGIN=http://localhost:5173
SERVER_URL=http://localhost:5000

# Security
NODE_ENV=development
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
